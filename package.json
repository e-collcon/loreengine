{
  "name": "loreengine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "typecheck": "node tools/typecheck.mjs",
    "build": "npm run build -w @loreengine/player && npm run build -w @loreengine/editor",
    "test": "vitest run",
    "lint:random": "node tools/ban-math-random.mjs",
    "bench": "node --expose-gc tools/bench.mjs",
    "gates": "npm run typecheck && npm run build && npm run lint:random && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
